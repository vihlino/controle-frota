# Copie este arquivo para .env e preencha os valores reais.
# NUNCA suba o .env para o GitHub.

# Porta da API (o Render injeta isso automaticamente)
PORT=3333

# Banco de dados (o Render gera esses valores ao criar o Postgres)
PGHOST=
PGPORT=5432
PGDATABASE=sitra
PGUSER=sitra
PGPASSWORD=

# TLS no banco. "true" para Neon e qualquer banco na nuvem; deixe vazio para o
# Postgres instalado na propria maquina, que roda sem TLS.
PGSSL=

# Endereco publico do sistema, gravado DENTRO do QR Code de cada veiculo
# (sem barra no final). Em producao e OBRIGATORIA: a URL do site na Vercel.
#
# Em desenvolvimento pode ficar vazia: a API descobre sozinha o IP desta maquina
# na rede local e usa http://<ip>:5173, entao o QR Code ja abre no celular
# ligado no mesmo Wi-Fi. O endereco escolhido aparece no log quando a API sobe.
# Preencha so se a maquina tiver mais de uma placa de rede e a deduzida for a
# errada:
#   URL_PUBLICA=http://192.168.0.10:5173
URL_PUBLICA=

# JWT - use um valor longo e aleatorio em producao:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Primeiro acesso (usado pelo npm run seed)
SEED_LOGIN=admin
SEED_SENHA=
