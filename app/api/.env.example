# Copie este arquivo para .env e preencha os valores reais.
# NUNCA suba o .env para o GitHub.

# Porta da API (o Render injeta isso automaticamente)
PORT=3333

# Banco de dados (o Render gera esses valores ao criar o Postgres)
PGHOST=
PGPORT=5432
PGDATABASE=sitra
PGUSER=sitra
PGPASSWORD=

# JWT - use um valor longo e aleatorio em producao:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Primeiro acesso (usado pelo npm run seed)
SEED_LOGIN=admin
SEED_SENHA=
